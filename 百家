<!DOCTYPE html>
<html lang="zh">
<head>
  <meta charset="UTF-8">
  <title>百家樂預測程式</title>
  <style>
    body { font-family: Arial, sans-serif; text-align: center; background: #f7f7f7; }
    h1 { color: #333; }
    textarea { width: 80%; height: 80px; margin: 10px; font-size: 16px; }
    button { padding: 10px 20px; font-size: 18px; margin: 10px; cursor: pointer; }
    .result { margin-top: 20px; font-size: 20px; font-weight: bold; }
    .box { background: #fff; padding: 20px; margin: 20px auto; width: 90%; max-width: 600px; border-radius: 10px; box-shadow: 0 0 10px rgba(0,0,0,0.1); }
  </style>
</head>
<body>
  <div class="box">
    <h1>百家樂預測程式</h1>
    <p>請輸入歷史紀錄（B = 莊, P = 閒, T = 和）</p>
    <textarea id="history" placeholder="例如：BBPPTBBPBB..."></textarea><br>
    <button onclick="predict()">預測</button>
    <div class="result" id="output"></div>
  </div>

  <script>
    function frequencyPredictor(history) {
      let count = {B:0,P:0,T:0};
      for (let c of history) if (count[c]!==undefined) count[c]++;
      let total = history.length;
      let scores = {B:count.B/total, P:count.P/total, T:count.T/total};
      let rec = Object.keys(scores).reduce((a,b)=>scores[a]>scores[b]?a:b);
      return {rec, scores};
    }

    function lastPatternPredictor(history, maxK=6) {
      let n = history.length;
      for (let k=maxK;k>0;k--) {
        if (n<=k) continue;
        let pattern = history.slice(n-k);
        let followers = [];
        for (let i=0;i<n-k;i++) {
          if (history.slice(i,i+k)===pattern) followers.push(history[i+k]);
        }
        if (followers.length>0) {
          let count = {B:0,P:0,T:0};
          for (let f of followers) count[f]++;
          let total = followers.length;
          let scores = {B:count.B/total, P:count.P/total, T:count.T/total};
          let rec = Object.keys(scores).reduce((a,b)=>scores[a]>scores[b]?a:b);
          return {rec, scores, k};
        }
      }
      return {rec:null, scores:{B:0,P:0,T:0}, k:0};
    }

    function markovPredictor(history) {
      let trans = {B:{B:0,P:0,T:0}, P:{B:0,P:0,T:0}, T:{B:0,P:0,T:0}};
      for (let i=0;i<history.length-1;i++) {
        let a=history[i], b=history[i+1];
        if (trans[a]) trans[a][b]++;
      }
      let last = history[history.length-1];
      if (!last) return {rec:null,scores:{B:1/3,P:1/3,T:1/3},last:null};
      let row = trans[last];
      let total = row.B+row.P+row.T;
      let scores = total===0 ? {B:1/3,P:1/3,T:1/3} :
        {B:row.B/total,P:row.P/total,T:row.T/total};
      let rec = Object.keys(scores).reduce((a,b)=>scores[a]>scores[b]?a:b);
      return {rec,scores,last};
    }

    function ensemble(history) {
      let f = frequencyPredictor(history);
      let p = lastPatternPredictor(history);
      let m = markovPredictor(history);
      let combined = {B:0,P:0,T:0};
      for (let k of ["B","P","T"]) {
        combined[k]+=0.3*f.scores[k];
        combined[k]+=0.4*(p.scores[k]||0);
        combined[k]+=0.3*m.scores[k];
      }
      let rec = Object.keys(combined).reduce((a,b)=>combined[a]>combined[b]?a:b);
      let vals = Object.values(combined).sort((a,b)=>b-a);
      let conf = (vals[0]-vals[1])/(vals[0]+vals[1]);
      return {rec, scores:combined, confidence:conf, details:{f,p,m}};
    }

    function predict() {
      let history = document.getElementById("history").value.trim().toUpperCase().replace(/[^BPT]/g,"");
      if (!history) {
        document.getElementById("output").innerHTML="⚠️ 請輸入歷史紀錄！";
        return;
      }
      let res = ensemble(history);
      document.getElementById("output").innerHTML =
        `建議：<span style="color:blue">${res.rec}</span><br>`+
        `信心：${(res.confidence*100).toFixed(1)}%<br>`+
        `分數：莊 ${res.scores.B.toFixed(3)}, 閒 ${res.scores.P.toFixed(3)}, 和 ${res.scores.T.toFixed(3)}`;
    }
  </script>
</body>
</html>
